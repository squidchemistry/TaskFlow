# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ismo_db?sslmode=require"

# JWT
JWT_SECRET="change_this_to_a_long_random_secret_at_least_32_chars"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development

# CORS – comma-separated list of allowed web origins
ALLOWED_ORIGINS="http://localhost:3000"
CLIENT_URL="http://localhost:3000"

# Google OAuth (optional – leave blank to disable Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
