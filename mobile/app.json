{
  "expo": {
    "name": "TaskFlow",
    "slug": "ismo-taskflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563eb"
      },
      "package": "com.ismo.taskflow"
    },
    "extra": {
      "apiUrl": "http://10.0.2.2:4000"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
